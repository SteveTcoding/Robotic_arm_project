#include <Servo.h>
Servo servo1;//create servo object to control a servo
Servo servo2;
Servo servo3;
Servo servo4;
Servo servo5;

//Initial positions of servos
int dataServo1 = 80;
int dataServo2 = 5; 
int dataServo3 = 0; 
int dataServo4 = 100; 
int dataServo5 = 0; 

 // defining the deviation in degrees of the servo
float dirServo1Offset = 0;   
float dirServo2Offset = 0;   
float dirServo3Offset = 0;   
float dirServo4Offset = 0;     
float dirServo5Offset = 0;   

// Defining variables for the values read from the potentiometers
int val1; 
int val2;
int val3;
int val4;
int val5;
void setup()
{
  servo1.attach(9);//attachs the servo1 on pin 9 to servo object
  servo2.attach(6);
  servo3.attach(5);
  servo4.attach(3);
  servo5.attach(11);
  
  //sets the servos to their initial positions
  servo1.write(dataServo1+dirServo1Offset);
  servo2.write(dataServo2+dirServo2Offset);
  servo3.write(dataServo3+dirServo3Offset);
  servo4.write(dataServo4+dirServo4Offset);
  servo5.write(dataServo5+dirServo5Offset);
}

void loop()
{
  //Converts potentiometer values into appropiate degrees in servo
  val1 = map(analogRead(A0), 0, 1023, 0, 180);
  val2 = map(analogRead(A1), 0, 1023, 0, 180);
  val3 = map(analogRead(A2), 0, 1023, 0, 180);
  val4 = map(analogRead(A3), 0, 1023, 0, 180);
  val5 = map(analogRead(A6), 0, 1023, 35, 90);

  //moves servo to its appropiate angle using the potentiometer values
  servo1.write(val1 + dirServo1Offset);
  servo2.write(val2 + dirServo2Offset);
  servo3.write(val3 + dirServo3Offset);
  servo4.write(val4 + dirServo4Offset);
  servo5.write(val5 + dirServo5Offset);

  delay(50);
}
